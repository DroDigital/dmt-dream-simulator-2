{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "dmt/diary.json",
 "type": "object",
 "required": [
  "fragments"
 ],
 "properties": {
  "$comment": {
   "type": "string"
  },
  "fragments": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 3
   },
   "minItems": 365,
   "maxItems": 365
  }
 },
 "additionalProperties": false
}