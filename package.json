{
  "name": "dmt-dream-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DMT: Dream Simulator (Dream Memory Transit) - a playable dream for 1-4 local players",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "import": "node tools/import/index.ts",
    "realmgen": "node tools/realmgen/index.ts",
    "validate-data": "node tools/validate-data/index.ts",
    "make-test-pack": "node tools/import/make-test-pack.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "bitecs": "0.4.0",
    "idb-keyval": "6.3.0",
    "simplex-noise": "4.0.3",
    "three": "0.187.0",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "ajv": "8.20.0",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "tweakpane": "4.0.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
